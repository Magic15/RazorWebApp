@page
@model IndexModel
@{
    ViewData["Title"] = "Dokumenty";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Dokumenty</h1>
        <p class="text-muted mb-0">Dokumenty są obsługiwane przez niezależne API backendowe.</p>
    </div>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#uploadModal">
        Dodaj dokument
    </button>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

@if (Model.BackendError is not null)
{
    <div class="alert alert-danger" role="alert">@Model.BackendError</div>
}

@if (Model.Documents.Count == 0 && Model.BackendError is null)
{
    <div class="card"><div class="card-body text-muted">Brak dokumentów. Dodaj pierwszy plik.</div></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Plik</th><th>Typ dokumentu</th><th>Status skanowania</th><th>Data dodania</th><th></th></tr></thead>
            <tbody>
            @foreach (var document in Model.Documents)
            {
                <tr data-third-party-document-id="@document.ThirdPartyDocumentId" data-local-document-id="@document.Id">
                    <td>@document.FileName</td>
                    <td>@document.DocumentType</td>
                    <td class="scan-status">@document.ScanStatus</td>
                    <td>@document.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end">
                        @if (document.ScanStatus == "Approved")
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="@($"{Model.BackendApiBaseUrl}/api/documents/{document.Id}/file")">Pobierz</a>
                        }
                        else
                        {
                            <span class="text-muted">Dostępny po akceptacji</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="uploadDocumentForm" enctype="multipart/form-data">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="uploadModalTitle">Dodaj dokument</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    <div id="uploadError" class="alert alert-danger d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="DocumentType" class="form-label">Typ dokumentu</label>
                        <input id="DocumentType" name="documentType" class="form-control" maxlength="100" required placeholder="np. Umowa, faktura" />
                    </div>
                    <div>
                        <label for="Upload" class="form-label">Plik</label>
                        <input id="Upload" name="file" class="form-control" type="file" required />
                        <div class="form-text">Maksymalny rozmiar pliku: 10 MB.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anuluj</button>
                    <button id="uploadSubmitButton" type="submit" class="btn btn-primary">Wyślij do skanera</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="backendConfig" data-api-base-url="@Model.BackendApiBaseUrl"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const backendApiBaseUrl = document.getElementById('backendConfig').dataset.apiBaseUrl;

        function getApiError(payload, fallback) {
            if (payload.error) return payload.error;
            if (payload.errors) return Object.values(payload.errors).flat().join(' ');
            return fallback;
        }

        const uploadForm = document.getElementById('uploadDocumentForm');
        uploadForm.addEventListener('submit', async event => {
            event.preventDefault();
            const errorBox = document.getElementById('uploadError');
            const submitButton = document.getElementById('uploadSubmitButton');
            const file = document.getElementById('Upload').files[0];
            const documentType = document.getElementById('DocumentType').value.trim();
            errorBox.classList.add('d-none');
            submitButton.disabled = true;
            submitButton.textContent = 'Wysyłanie...';

            try {
                const uploadFormData = new FormData();
                uploadFormData.append('file', file);
                const uploadResponse = await fetch(backendApiBaseUrl + '/api/scanned-documents', {
                    method: 'POST',
                    body: uploadFormData
                });
                const uploadResult = await uploadResponse.json();
                if (!uploadResponse.ok)
                    throw new Error(getApiError(uploadResult, 'Nie udało się wysłać pliku do skanera.'));

                const documentResponse = await fetch(backendApiBaseUrl + '/api/documents', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fileName: uploadResult.fileName,
                        documentType,
                        thirdPartyDocumentId: uploadResult.thirdPartyDocumentId
                    })
                });
                const documentResult = await documentResponse.json();
                if (!documentResponse.ok)
                    throw new Error(getApiError(documentResult, 'Plik wysłano do skanera, ale nie udało się zapisać metadanych.'));

                window.location.reload();
            } catch (error) {
                errorBox.textContent = error.message;
                errorBox.classList.remove('d-none');
                submitButton.disabled = false;
                submitButton.textContent = 'Wyślij do skanera';
            }
        });

        if (!window.EventSource) return;

        const events = new EventSource(backendApiBaseUrl + '/api/scanned-documents/status-events');
        events.addEventListener('scan-status', event => {
            const update = JSON.parse(event.data);
            const row = document.querySelector(`[data-third-party-document-id="${update.thirdPartyDocumentId}"]`);
            if (row) {
                row.querySelector('.scan-status').textContent = update.status;
                const actionCell = row.lastElementChild;
                if (update.status === 'Approved') {
                    const link = document.createElement('a');
                    link.className = 'btn btn-sm btn-outline-secondary';
                    link.href = backendApiBaseUrl + '/api/documents/' + encodeURIComponent(row.dataset.localDocumentId) + '/file';
                    link.textContent = 'Pobierz';
                    actionCell.replaceChildren(link);
                } else {
                    const hint = document.createElement('span');
                    hint.className = 'text-muted';
                    hint.textContent = 'Dostępny po akceptacji';
                    actionCell.replaceChildren(hint);
                }
            }
        });
    });
</script>

@if (!ViewData.ModelState.IsValid)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => bootstrap.Modal.getOrCreateInstance(document.getElementById('uploadModal')).show());
    </script>
}
